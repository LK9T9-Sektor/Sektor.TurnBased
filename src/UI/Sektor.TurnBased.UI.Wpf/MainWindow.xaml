<Window x:Class="Sektor.TurnBased.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sektor.TurnBased.UI.Wpf.Views"
        Title="Sektor · Пошаговые игры"
        Width="1120" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
            <DockPanel>
                <Button Content="⚙"
                        Command="{Binding Settings.ToggleCommand}"
                        Style="{StaticResource NeutralButton}"
                        DockPanel.Dock="Right"
                        FontSize="16"
                        Padding="12,4"
                        ToolTip="Настройки" />
                <TextBlock Text="Sektor · Пошаговые игры"
                           Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Navigation.Current}" />

        <views:UnitInfoPopup Grid.RowSpan="2" DataContext="{Binding UnitInfo}" />
        <views:AbilityInfoPopup Grid.RowSpan="2" DataContext="{Binding AbilityInfo}" />
        <views:ConfirmationPrompt Grid.RowSpan="2" DataContext="{Binding Confirmation}" />
        <views:SettingsView Grid.RowSpan="2" DataContext="{Binding Settings}" />
    </Grid>
</Window>
