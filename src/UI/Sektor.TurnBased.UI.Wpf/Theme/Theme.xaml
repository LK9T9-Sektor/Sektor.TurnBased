<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:vmLobby="clr-namespace:Sektor.TurnBased.UI.ViewModels.Lobby;assembly=Sektor.TurnBased.UI.ViewModels"
                    xmlns:vmBattle="clr-namespace:Sektor.TurnBased.UI.ViewModels.Battle;assembly=Sektor.TurnBased.UI.ViewModels"
                    xmlns:vmDialog="clr-namespace:Sektor.TurnBased.UI.ViewModels.Dialog;assembly=Sektor.TurnBased.UI.ViewModels"
                    xmlns:views="clr-namespace:Sektor.TurnBased.UI.Wpf.Views"
                    xmlns:converters="clr-namespace:Sektor.TurnBased.UI.Wpf.Theme"
                    xmlns:controls="clr-namespace:Sektor.TurnBased.UI.Wpf.Controls">

    <!-- Кисти -->
    <SolidColorBrush x:Key="BgBrush" Color="#15151A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1F1F26" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#34343E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E8A94E" />
    <SolidColorBrush x:Key="PlayerBrush" Color="#2F6B94" />
    <SolidColorBrush x:Key="EnemyBrush" Color="#963D3D" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F4" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B8B8C4" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F07878" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#A0181818" />

    <!-- Конвертеры -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <converters:NullToVisibilityConverter x:Key="NotNullToVisibility" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibility" Invert="True" />
    <converters:TeamToBrushConverter x:Key="TeamToBrush"
                                    Player="{StaticResource PlayerBrush}"
                                    Enemy="{StaticResource EnemyBrush}" />

    <!-- Размеры -->
    <sys:Double x:Key="FontSizePageTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeSection">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeDialog">18</sys:Double>

    <!-- Стили текста -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DialogText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDialog}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Контейнеры -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="UnitCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Width" Value="188" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- Кнопки -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#14141C" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}" />
    <Style x:Key="NeutralButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Карточка юнита в бою -->
    <DataTemplate x:Key="UnitCardTemplate" DataType="{x:Type vmBattle:UnitCardViewModel}">
        <Border
                controls:InputBehavior.RightClickCommand="{Binding DataContext.ShowUnitInfoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                controls:InputBehavior.LeftClickCommand="{Binding DataContext.ChooseTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource UnitCard}">
                    <Setter Property="Background" Value="{Binding Unit.TeamId, Converter={StaticResource TeamToBrush}}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelectable}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelectedTarget}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDead}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,8,6"
                            DockPanel.Dock="Right"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Ход" Foreground="#14141C" FontWeight="Bold"
                                   FontSize="{StaticResource FontSizeSmall}" />
                    </Border>
                    <TextBlock Text="{Binding Unit.DisplayName}" Style="{StaticResource CardTitle}" />
                </DockPanel>
                <TextBlock Text="{Binding Unit.TeamDisplayName}" Style="{StaticResource MutedText}" Margin="0,2,0,6" />
                <ProgressBar Height="6" Value="{Binding Unit.VitalStat.Current}" Maximum="{Binding Unit.VitalStat.Max}"
                             Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Unit.Stats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" Width="90" />
                                <TextBlock Text="{Binding Current}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding Max, StringFormat=/{0}}" Style="{StaticResource MutedText}"
                                           Visibility="{Binding Max, Converter={StaticResource NotNullToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Unit.StatusIds}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#553C3C50" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                                <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Соответствие VM -> представление -->
    <DataTemplate DataType="{x:Type vmLobby:LobbyViewModel}">
        <views:LobbyView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmBattle:BattleViewModel}">
        <views:BattleView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmDialog:DialogViewModel}">
        <views:DialogView />
    </DataTemplate>

</ResourceDictionary>
