<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:core="clr-namespace:Sektor.TurnBased.UI.Core;assembly=Sektor.TurnBased.UI.Core"
                    xmlns:vmLobby="clr-namespace:Sektor.TurnBased.UI.ViewModels.Lobby;assembly=Sektor.TurnBased.UI.ViewModels"
                    xmlns:vmBattle="clr-namespace:Sektor.TurnBased.UI.ViewModels.Battle;assembly=Sektor.TurnBased.UI.ViewModels"
                    xmlns:vmDialog="clr-namespace:Sektor.TurnBased.UI.ViewModels.Dialog;assembly=Sektor.TurnBased.UI.ViewModels"
                    xmlns:views="clr-namespace:Sektor.TurnBased.UI.Wpf.Views"
                    xmlns:converters="clr-namespace:Sektor.TurnBased.UI.Wpf.Theme"
                    xmlns:controls="clr-namespace:Sektor.TurnBased.UI.Wpf.Controls">

    <!-- Кисти -->
    <SolidColorBrush x:Key="BgBrush" Color="#1B1B24" />
    <SolidColorBrush x:Key="PanelBrush" Color="#262633" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A4D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E0A84C" />
    <SolidColorBrush x:Key="PlayerBrush" Color="#3A5B8C" />
    <SolidColorBrush x:Key="EnemyBrush" Color="#7C3A3A" />
    <SolidColorBrush x:Key="TextBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A0B8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E07070" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#A014141C" />

    <!-- Конвертеры -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <converters:NullToVisibilityConverter x:Key="NotNullToVisibility" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibility" Invert="True" />
    <converters:TeamToBrushConverter x:Key="TeamToBrush"
                                    Player="{StaticResource PlayerBrush}"
                                    Enemy="{StaticResource EnemyBrush}" />

    <!-- Размеры -->
    <sys:Double x:Key="FontSizePageTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeSection">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeDialog">18</sys:Double>

    <!-- Стили текста -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DialogText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDialog}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Контейнеры -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="UnitCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Width" Value="188" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- Кнопки -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#14141C" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}" />
    <Style x:Key="NeutralButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Карточка юнита (общая для боя и инфо-панели) -->
    <DataTemplate x:Key="UnitCardTemplate" DataType="{x:Type core:UnitSnapshot}">
        <Border Style="{StaticResource UnitCard}"
                Background="{Binding TeamId, Converter={StaticResource TeamToBrush}}"
                controls:InputBehavior.RightClickCommand="{Binding DataContext.ShowUnitInfoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                controls:InputBehavior.LeftClickCommand="{Binding DataContext.ChooseTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding TeamDisplayName}" Style="{StaticResource MutedText}" Margin="0,2,0,6" />
                <ProgressBar Height="6" Value="{Binding VitalStat.Current}" Maximum="{Binding VitalStat.Max}"
                             Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" Width="90" />
                                <TextBlock Text="{Binding Current}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding Max, StringFormat=/{0}}" Style="{StaticResource MutedText}"
                                           Visibility="{Binding Max, Converter={StaticResource NotNullToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding StatusIds}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#553C3C50" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                                <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Соответствие VM -> представление -->
    <DataTemplate DataType="{x:Type vmLobby:LobbyViewModel}">
        <views:LobbyView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmBattle:BattleViewModel}">
        <views:BattleView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmDialog:DialogViewModel}">
        <views:DialogView />
    </DataTemplate>

</ResourceDictionary>
