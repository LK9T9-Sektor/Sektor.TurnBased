<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:vmLobby="clr-namespace:Sektor.TurnBased.UI.ViewModels.Lobby;assembly=Sektor.TurnBased.UI.ViewModels"
                    xmlns:vmBattle="clr-namespace:Sektor.TurnBased.UI.ViewModels.Battle;assembly=Sektor.TurnBased.UI.ViewModels"
                    xmlns:vmDialog="clr-namespace:Sektor.TurnBased.UI.ViewModels.Dialog;assembly=Sektor.TurnBased.UI.ViewModels"
                    xmlns:views="clr-namespace:Sektor.TurnBased.UI.Wpf.Views"
                    xmlns:converters="clr-namespace:Sektor.TurnBased.UI.Wpf.Theme"
                    xmlns:controls="clr-namespace:Sektor.TurnBased.UI.Wpf.Controls">

    <!-- Палитра (стиль Blades): тёмная бронза, золото, сталь и кровь -->
    <SolidColorBrush x:Key="BgBrush" Color="#1E242B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#2B1A10" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3D2B1F" />
    <Color x:Key="AccentColor">#D4AF37</Color>
    <Color x:Key="TitleColor">#E8A34D</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TitleColor}" />
    <SolidColorBrush x:Key="PlayerBrush" Color="#4682B4" />
    <SolidColorBrush x:Key="EnemyBrush" Color="#800000" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#C4AE82" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E53935" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#A0181818" />
    <SolidColorBrush x:Key="ActiveBrush" Color="#00FFFF" />
    <SolidColorBrush x:Key="VsBrush" Color="{StaticResource TitleColor}" />
    <SolidColorBrush x:Key="HpBrush" Color="#4CAF50" />
    <SolidColorBrush x:Key="PanelDarkBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ChipBrush" Color="#553C3C50" />
    <SolidColorBrush x:Key="SelectedTileBrush" Color="#55D4AF37" />
    <SolidColorBrush x:Key="HpTrackBrush" Color="#222" />

    <!-- Фон поля боя (радиальный градиент, как в Blades) -->
    <RadialGradientBrush x:Key="BattlefieldBrush"
                         Center="0.5,0.5"
                         RadiusX="0.7"
                         RadiusY="0.7">
        <GradientStop Color="#1E242B"
                      Offset="0" />
        <GradientStop Color="#14181D"
                      Offset="1" />
    </RadialGradientBrush>

    <!-- Кровавая виньетка по краям поля боя -->
    <RadialGradientBrush x:Key="BloodVignetteBrush"
                         Center="0.5,0.5"
                         RadiusX="0.7"
                         RadiusY="0.7"
                         GradientOrigin="0.5,0.5">
        <GradientStop Color="Transparent"
                      Offset="0.5" />
        <GradientStop Color="#99AA0000"
                      Offset="1" />
    </RadialGradientBrush>

    <!-- Градиент панелей (верхняя/нижняя, как в Blades) -->
    <LinearGradientBrush x:Key="PanelGradientBrush"
                         EndPoint="1,0.5"
                         StartPoint="0,0.5">
        <GradientStop Color="#2B1A10"
                      Offset="0" />
        <GradientStop Color="#3D2B1F"
                      Offset="0.5" />
        <GradientStop Color="#2B1A10"
                      Offset="1" />
    </LinearGradientBrush>

    <!-- Глиф-иконки юнитов (геометрии из Blades) -->
    <Geometry x:Key="IconCircle">M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z</Geometry>
    <Geometry x:Key="IconDrop">M12,2 S6,8.5 6,12.5 A6,6 0 1,0 18,12.5 S12,2 12,2 Z</Geometry>
    <Geometry x:Key="IconVSX">M20,6.91L17.09,4L12,9.09L6.91,4L4,6.91L9.09,12L4,17.09L6.91,20L12,14.91L17.09,20L20,17.09L14.91,12L20,6.91Z</Geometry>
    <Geometry x:Key="IconSkeleton">M12,2C7.58,2 4,5.58 4,10C4,12.11 4.82,14.03 6.16,15.46L6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19L17.84,15.46C19.18,14.03 20,12.11 20,10C20,5.58 16.42,2 12,2M9,9A2,2 0 0,1 11,11A2,2 0 0,1 9,13A2,2 0 0,1 7,11A2,2 0 0,1 9,9M15,9A2,2 0 0,1 17,11A2,2 0 0,1 15,13A2,2 0 0,1 13,11A2,2 0 0,1 15,9M10,17H14V19H10V17Z</Geometry>
    <Geometry x:Key="IconSkeletonMage">M12,2L3,9V11H21V9L12,2M12,12C7.58,12 4,15.58 4,20C4,22.11 4.82,24.03 6.16,25.46L6,29A2,2 0 0,0 8,31H16A2,2 0 0,0 18,29L17.84,25.46C19.18,24.03 20,22.11 20,20C20,15.58 16.42,12 12,12M9,19A2,2 0 0,1 11,21A2,2 0 0,1 9,23A2,2 0 0,1 7,21A2,2 0 0,1 9,19M15,19A2,2 0 0,1 17,21A2,2 0 0,1 15,23A2,2 0 0,1 13,21A2,2 0 0,1 15,19Z</Geometry>
    <Geometry x:Key="IconTombstone">M12,2A9,9 0 0,0 3,11V22H21V11A9,9 0 0,0 12,2M12,4A7,7 0 0,1 19,11V20H15V17H13V20H11V17H9V20H5V11A7,7 0 0,1 12,4M11,7V9H9V11H11V14H13V11H15V9H13V7H11Z</Geometry>
    <Geometry x:Key="IconZombie">M16,21H8A1,1 0 0,1 7,20V19C7,18.9 7,18.8 7,18.7L8.2,14.5C7,13.9 6.2,12.7 6,11.3C5.8,9.7 6.6,8.2 8,7.4V3A1,1 0 0,1 9,2H10A1,1 0 0,1 11,3V6H12V4A1,1 0 0,1 13,3H14A1,1 0 0,1 15,4V7H16V5A1,1 0 0,1 17,4H18A1,1 0 0,1 19,5V11C19,13.2 17.8,15.1 16,16.2V20A1,1 0 0,1 15,21H16Z</Geometry>
    <Geometry x:Key="IconArcher">M4,12 C4,12 8,2 14,2 M4,12 C4,12 8,22 14,22 M14,2 L10,12 L14,22 M18,9 L22,12 L18,15</Geometry>
    <Geometry x:Key="IconPriestess">M12,2A5,5 0 0,0 7,7C7,9.39 8.71,11.38 11,11.89V14H8V16H11V22H13V16H16V14H13V11.89C15.29,11.38 17,9.39 17,7A5,5 0 0,0 12,2M12,4A3,3 0 0,1 15,7A3,3 0 0,1 12,10A3,3 0 0,1 9,7A3,3 0 0,1 12,4Z</Geometry>
    <Geometry x:Key="IconShield">M12,2L4.5,5V10C4.5,14.6 7.7,18.9 12,20C16.3,18.9 19.5,14.6 19.5,10V5L12,2M17.5,10C17.5,13.6 15.1,16.9 12,18C8.9,16.9 6.5,13.6 6.5,10V6.3L12,4.1L17.5,6.3V10Z</Geometry>
    <Geometry x:Key="IconDagger">M12.5,2.5 C12,3 9,8 9,11 C9,13.5 10.5,15.5 11,16 L11,18 L8,18 L8,20 L11,20 L11,22 L13,22 L13,20 L16,20 L16,18 L13,18 L13,16 C13.5,15.5 15,13.5 15,11 C15,8 12.5,3 12.5,2.5 M12,14 C11,14 10,12.5 10,11 C10,9 11.5,5 12,4 C12.5,5 14,9 14,11 C14,12.5 13,14 12,14 Z</Geometry>

    <!-- Конвертеры -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <converters:NullToVisibilityConverter x:Key="NotNullToVisibility" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibility" Invert="True" />
    <converters:TeamToBrushConverter x:Key="TeamToBrush"
                                    Player="{StaticResource PlayerBrush}"
                                    Enemy="{StaticResource EnemyBrush}" />
    <converters:StringToBrushConverter x:Key="StringToBrush" />
    <converters:IconKeyToGeometryConverter x:Key="IconToGeometry" />

    <!-- Размеры -->
    <sys:Double x:Key="FontSizePageTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeSection">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeDialog">18</sys:Double>
    <sys:Double x:Key="FontSizeVs">60</sys:Double>
    <sys:Double x:Key="FontSizeGlyph">24</sys:Double>
    <sys:Double x:Key="FontSizeTileName">12</sys:Double>
    <sys:Double x:Key="FontSizeLineName">12</sys:Double>
    <sys:Double x:Key="FontSizeLineHp">10</sys:Double>
    <sys:Double x:Key="FontSizeFloat">16</sys:Double>
    <sys:Double x:Key="FontSizeFloatCrit">22</sys:Double>
    <sys:Double x:Key="AbilityTileSize">72</sys:Double>
    <sys:Double x:Key="AbilityGlyphSize">38</sys:Double>
    <sys:Double x:Key="LogListHeight">120</sys:Double>
    <sys:Double x:Key="LineIconSize">80</sys:Double>
    <sys:Double x:Key="LineHpRowHeight">16</sys:Double>
    <sys:Double x:Key="TurnTokenSize">40</sys:Double>
    <GridLength x:Key="TurnTokenRowHeight">40</GridLength>

    <!-- Стили текста -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DialogText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDialog}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Контейнеры -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="UnitCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Width" Value="188" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- Кнопки -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource PanelBrush}" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelBorderBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource MutedTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource TitleBrush}" />
                            <Setter Property="Foreground"
                                    Value="#1E242B" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}" />
    <Style x:Key="NeutralButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Общий стиль панелей (верхняя, нижняя, лог) -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Кнопка-глиф (☰ в шапке, × в попапах) -->
    <Style x:Key="IconGlyphButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Списки лога (лента событий и журнал) -->
    <Style x:Key="LogList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{StaticResource LogListHeight}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Надпись VS на поле боя -->
    <Style x:Key="VsTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VsBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeVs}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource TitleColor}"
                                  BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.8" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Полоса здоровья (цвет задаётся привязкой; здесь только основа) -->
    <Style x:Key="HpBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource HpTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Чекбоксы настроек -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Всплывающий текст урона/лечения над карточкой: подъём и растворение
         анимирует BattleViewModel через OffsetY/Opacity. Крит — крупнее и золотом. -->
    <DataTemplate x:Key="FloatingTextTemplate" DataType="{x:Type vmBattle:FloatingTextViewModel}">
        <TextBlock Text="{Binding Text}"
                   Opacity="{Binding Opacity}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   TextAlignment="Center"
                   FontWeight="Bold"
                   FontSize="{StaticResource FontSizeFloat}"
                   Margin="0,0,0,6"
                   RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="{Binding OffsetY}" />
            </TextBlock.RenderTransform>
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground"
                            Value="{StaticResource DangerBrush}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black"
                                              BlurRadius="4"
                                              ShadowDepth="1" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHeal}"
                                     Value="True">
                            <Setter Property="Foreground"
                                    Value="{StaticResource HpBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCrit}"
                                     Value="True">
                            <Setter Property="FontSize"
                                    Value="{StaticResource FontSizeFloatCrit}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!-- Карточка юнита: две линии (информативная, статы внутри) -->
    <DataTemplate x:Key="UnitCardTemplate" DataType="{x:Type vmBattle:UnitCardViewModel}">
        <Border
                controls:InputBehavior.RightClickCommand="{Binding DataContext.ShowUnitInfoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                controls:InputBehavior.LeftClickCommand="{Binding DataContext.ChooseTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource UnitCard}">
                    <Setter Property="Background" Value="{StaticResource PanelDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{Binding Unit.TeamId, Converter={StaticResource TeamToBrush}}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1"
                                            ScaleY="1" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Пульсация активного юнита (отключается в настройках) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}"
                                          Value="True" />
                                <Condition Binding="{Binding DataContext.Settings.PulseEffects, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="CardPulse">
                                    <Storyboard RepeatBehavior="Forever"
                                                AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05"
                                                         Duration="0:0:0.9">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05"
                                                         Duration="0:0:0.9">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="CardPulse" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0"
                                                         Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0"
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsSelectable}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderThickness"
                                    Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ActiveBrush}" />
                            <Setter Property="BorderThickness"
                                    Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelectedTarget}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderThickness"
                                    Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDead}"
                                     Value="True">
                            <Setter Property="Opacity"
                                    Value="0.55" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <StackPanel>
                <DockPanel>
                    <Border Background="{StaticResource AccentBrush}"
                            CornerRadius="3"
                            Padding="6,2"
                            Margin="0,0,8,6"
                            DockPanel.Dock="Right"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Ход"
                                   Foreground="{StaticResource TitleBrush}"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource FontSizeSmall}" />
                    </Border>
                    <TextBlock Text="{Binding Unit.DisplayName}"
                               Style="{StaticResource CardTitle}" />
                </DockPanel>
                <TextBlock Text="{Binding Unit.TeamDisplayName}"
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,6" />
                <ProgressBar Height="8"
                             Value="{Binding Unit.VitalStat.Current}"
                             Maximum="{Binding Unit.VitalStat.Max}"
                             Foreground="{Binding HpColorHex, Converter={StaticResource StringToBrush}}"
                             Style="{StaticResource HpBar}"
                             Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Unit.Stats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,2,0,0">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource MutedText}"
                                           Width="90" />
                                <TextBlock Text="{Binding Current}"
                                           Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding Max, StringFormat=/{0}}"
                                           Style="{StaticResource MutedText}"
                                           Visibility="{Binding Max, Converter={StaticResource NotNullToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Unit.StatusIds}"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource ChipBrush}"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Margin="0,0,4,4">
                                <TextBlock Text="{Binding}"
                                           Style="{StaticResource MutedText}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding FloatingTexts}"
                              IsHitTestVisible="False"
                              ItemTemplate="{StaticResource FloatingTextTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Карточка юнита: одна линия (Blades-стиль, только имя, иконка и ХП) -->
    <DataTemplate x:Key="UnitCardLineTemplate" DataType="{x:Type vmBattle:UnitCardViewModel}">
        <Border Margin="10"
                controls:InputBehavior.RightClickCommand="{Binding DataContext.ShowUnitInfoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                controls:InputBehavior.LeftClickCommand="{Binding DataContext.ChooseTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Cursor"
                            Value="Hand" />
                    <Setter Property="BorderBrush"
                            Value="Transparent" />
                    <Setter Property="BorderThickness"
                            Value="1.5" />
                    <Setter Property="RenderTransformOrigin"
                            Value="0.5,0.5" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1"
                                            ScaleY="1" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}"
                                          Value="True" />
                                <Condition Binding="{Binding DataContext.Settings.PulseEffects, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="LinePulse">
                                    <Storyboard RepeatBehavior="Forever"
                                                AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.1"
                                                         Duration="0:0:1">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.1"
                                                         Duration="0:0:1">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LinePulse" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0"
                                                         Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0"
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsSelectable}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ActiveBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelectedTarget}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDead}"
                                     Value="True">
                            <Setter Property="Opacity"
                                    Value="0.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <StackPanel>
                <TextBlock Text="{Binding Unit.DisplayName}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="{StaticResource FontSizeLineName}"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,0,4">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2"
                                          ShadowDepth="1"
                                          Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
                <Border Width="{StaticResource LineIconSize}"
                        Height="{StaticResource LineIconSize}"
                        BorderThickness="2"
                        CornerRadius="4"
                        BorderBrush="{Binding Appearance.ColorHex, Converter={StaticResource StringToBrush}}"
                        Background="{StaticResource PanelDarkBrush}"
                        Margin="0,0,0,4">
                    <Grid>
                        <Rectangle Fill="{Binding Appearance.ColorHex, Converter={StaticResource StringToBrush}}"
                                   Opacity="0.12" />
                        <Path Data="{Binding IconKey, Converter={StaticResource IconToGeometry}}"
                              Fill="{Binding Appearance.ColorHex, Converter={StaticResource StringToBrush}}"
                              Stretch="Uniform"
                              Margin="12" />
                        <Border BorderBrush="{StaticResource ActiveBrush}"
                                BorderThickness="2"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                            <Border.Effect>
                                <BlurEffect Radius="8" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </Border>
                <Grid Width="{StaticResource LineIconSize}"
                      Height="{StaticResource LineHpRowHeight}">
                    <ProgressBar Value="{Binding Unit.VitalStat.Current}"
                                 Maximum="{Binding Unit.VitalStat.Max}"
                                 Foreground="{Binding HpColorHex, Converter={StaticResource StringToBrush}}"
                                 Style="{StaticResource HpBar}"
                                 Background="{StaticResource HpTrackBrush}" />
                    <TextBlock Text="{Binding HpLabel}"
                               FontSize="{StaticResource FontSizeLineHp}"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="1"
                                              ShadowDepth="1" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding FloatingTexts}"
                              IsHitTestVisible="False"
                              ItemTemplate="{StaticResource FloatingTextTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Плитка действия: квадрат с глифом и имя под ним внутри (общий для всех боёв).
         ПКМ — подсказка (попап); наведение пока не реализовано. -->
    <DataTemplate x:Key="AbilityTileTemplate" DataType="{x:Type vmBattle:ActionTileViewModel}">
        <Border Width="{StaticResource AbilityTileSize}"
                Height="{StaticResource AbilityTileSize}"
                Margin="0,0,8,0"
                Padding="6,6"
                Cursor="Hand"
                CornerRadius="6"
                controls:InputBehavior.LeftClickCommand="{Binding DataContext.ChooseActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                controls:InputBehavior.RightClickCommand="{Binding DataContext.ShowActionInfoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
                            Value="{StaticResource ChipBrush}" />
                    <Setter Property="BorderBrush"
                            Value="{StaticResource PanelBorderBrush}" />
                    <Setter Property="BorderThickness"
                            Value="1.5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                            <Setter Property="Background"
                                    Value="{StaticResource SelectedTileBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource TitleBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Border Width="{StaticResource AbilityGlyphSize}"
                        Height="{StaticResource AbilityGlyphSize}"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}"
                               FontSize="{StaticResource FontSizeGlyph}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Name}"
                           FontSize="{StaticResource FontSizeTileName}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxHeight="32"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Соответствие VM -> представление -->
    <DataTemplate DataType="{x:Type vmLobby:LobbyViewModel}">
        <views:LobbyView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmBattle:BattleViewModel}">
        <views:BattleView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmDialog:DialogViewModel}">
        <views:DialogView />
    </DataTemplate>

</ResourceDictionary>
