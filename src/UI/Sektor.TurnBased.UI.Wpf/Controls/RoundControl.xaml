<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Controls.RoundControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="40">
    <Grid Width="40"
          Height="40">
        <Ellipse Stroke="{StaticResource AccentBrush}"
                 StrokeThickness="2"
                 Fill="{StaticResource PanelDarkBrush}">
            <Ellipse.Effect>
                <DropShadowEffect Color="{StaticResource AccentColor}"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.5" />
            </Ellipse.Effect>
        </Ellipse>
        <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="ExtraBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>
</UserControl>
