<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Controls.TurnOrderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="56"
             d:DesignWidth="400">

    <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid x:Name="TurnToken"
                      Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{StaticResource TurnTokenRowHeight}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="IconBorder"
                            Grid.Row="0"
                            Width="{StaticResource TurnTokenSize}"
                            Height="{StaticResource TurnTokenSize}"
                            BorderBrush="{Binding Appearance.ColorHex, Converter={StaticResource StringToBrush}}"
                            BorderThickness="1"
                            Background="{StaticResource PanelDarkBrush}">
                        <Grid>
                            <Rectangle Fill="{Binding Appearance.ColorHex, Converter={StaticResource StringToBrush}}"
                                       Opacity="0.2" />
                            <Path Data="{Binding Appearance.IconKey, Converter={StaticResource IconToGeometry}}"
                                  Fill="{Binding Appearance.ColorHex, Converter={StaticResource StringToBrush}}"
                                  Stretch="Uniform"
                                  Margin="7"
                                  Opacity="0.9" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource HpTrackBrush}"
                            BorderBrush="{Binding Appearance.ColorHex, Converter={StaticResource StringToBrush}}"
                            BorderThickness="1,0,1,1">
                        <TextBlock Text="{Binding Speed}"
                                   FontSize="10"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"
                                   Margin="0,1" />
                    </Border>

                    <Polygon x:Name="ActiveArrow"
                             Points="0,0 10,0 5,7"
                             Fill="{StaticResource ActiveBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,-8,0,0"
                             Visibility="Collapsed" />
                </Grid>

                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}"
                                 Value="True">
                        <Setter TargetName="IconBorder"
                                Property="BorderBrush"
                                Value="{StaticResource ActiveBrush}" />
                        <Setter TargetName="ActiveArrow"
                                Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasActed}"
                                 Value="True">
                        <Setter TargetName="TurnToken"
                                Property="Opacity"
                                Value="0.45" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
