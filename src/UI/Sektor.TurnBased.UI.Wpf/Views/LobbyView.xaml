<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <TextBlock Text="Лобби" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" />
            <TextBlock Text="Выберите игру:" Style="{StaticResource MutedText}" Margin="0,28,0,4" />
            <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" />
            <TextBlock Text="Seed:" Style="{StaticResource MutedText}" Margin="0,16,0,4" />
            <TextBox Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,8,0,0" />
            <Button Content="Старт" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center" Margin="0,28,0,0" Padding="32,10" />
            <TextBlock Text="Кооп-режим появится позже." Style="{StaticResource MutedText}"
                       Margin="0,20,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
