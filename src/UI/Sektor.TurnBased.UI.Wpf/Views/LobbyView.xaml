<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sektor.TurnBased.UI.Wpf.Controls">
    <Grid Background="{StaticResource BgBrush}">
        <StackPanel MaxWidth="1000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="40,20">
            <TextBlock Text="Лобби"
                       Style="{StaticResource PageTitle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Выберите игру:"
                       Style="{StaticResource MutedText}"
                       Margin="0,20,0,8"
                       HorizontalAlignment="Center" />

            <!-- Карточки выбора игры -->
            <ItemsControl ItemsSource="{Binding Options}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8"
                                Padding="16,14"
                                CornerRadius="8"
                                Cursor="Hand"
                                Background="{StaticResource PanelBrush}"
                                controls:InputBehavior.LeftClickCommand="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush"
                                            Value="{StaticResource PanelBorderBrush}" />
                                    <Setter Property="BorderThickness"
                                            Value="1.5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderThickness"
                                                    Value="2.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="✓"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold"
                                               DockPanel.Dock="Right"
                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource CardTitle}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Seed:"
                       Style="{StaticResource MutedText}"
                       Margin="0,20,0,4"
                       HorizontalAlignment="Center" />
            <TextBox Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     HorizontalAlignment="Center"
                     Padding="4,2" />
            <TextBlock Text="{Binding Error}"
                       Style="{StaticResource ErrorText}"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
            <Button Content="Старт"
                    Command="{Binding StartCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    Padding="32,10" />
            <Button Content="Мультиплеер"
                    Command="{Binding GoToMultiplayerCommand}"
                    Style="{StaticResource NeutralButton}"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0"
                    Padding="32,10" />
            <TextBlock Text="Кооп-режим появится позже."
                       Style="{StaticResource MutedText}"
                       Margin="0,20,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
