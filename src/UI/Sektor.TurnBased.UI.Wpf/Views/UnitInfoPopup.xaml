<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Views.UnitInfoPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Background="{StaticResource OverlayBrush}" />
        <Border Style="{StaticResource Card}" Width="320" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="16">
            <StackPanel>
                <DockPanel>
                    <Button Content="×" Command="{Binding CloseCommand}" Style="{StaticResource NeutralButton}"
                            DockPanel.Dock="Right" Padding="10,4" />
                    <TextBlock Text="{Binding Unit.DisplayName}" Style="{StaticResource CardTitle}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Unit.TeamDisplayName}" Style="{StaticResource MutedText}" Margin="0,2,0,10" />
                <ProgressBar Height="8" Value="{Binding Unit.VitalStat.Current}" Maximum="{Binding Unit.VitalStat.Max}"
                             Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Unit.Stats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock Text="{Binding Current}" Style="{StaticResource BodyText}" DockPanel.Dock="Right" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Unit.StatusIds}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#553C3C50" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                                <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
