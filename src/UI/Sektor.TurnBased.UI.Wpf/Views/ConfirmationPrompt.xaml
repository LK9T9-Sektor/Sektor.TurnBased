<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Views.ConfirmationPrompt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Background="{StaticResource OverlayBrush}" />
        <Border Style="{StaticResource Card}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Подтверждение действия" Style="{StaticResource PageTitle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,16,0,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Подтвердить" Command="{Binding ConfirmCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="28,8" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            Style="{StaticResource NeutralButton}" Margin="12,0,0,0" Padding="28,8" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
