<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Views.AbilityInfoPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Background="{StaticResource OverlayBrush}" />
        <Border Style="{StaticResource Card}"
                Width="340"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16">
            <StackPanel>
                <DockPanel>
                    <Button Content="×"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource NeutralButton}"
                            DockPanel.Dock="Right"
                            Padding="10,4" />
                    <TextBlock Text="{Binding Tile.Name}"
                               Style="{StaticResource CardTitle}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Tile.TargetModeDisplay}"
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,10" />
                <Border Width="48"
                        Height="48"
                        Background="{StaticResource ChipBrush}"
                        CornerRadius="4">
                    <TextBlock Text="{Binding Tile.Glyph}"
                               FontSize="26"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Tile.Description}"
                           Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
