<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="В лобби" Command="{Binding GoToLobbyCommand}" Style="{StaticResource NeutralButton}"
                    DockPanel.Dock="Right" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Ваши герои" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding PlayerUnits}" ItemTemplate="{StaticResource UnitCardTemplate}"
                          Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Враги" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding EnemyUnits}" ItemTemplate="{StaticResource UnitCardTemplate}"
                          Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Действия" Style="{StaticResource SectionTitle}" />
            <DockPanel Margin="0,8,0,0">
                <Button Content="Завершить ход" Command="{Binding EndTurnCommand}"
                        Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" />
                <ItemsControl ItemsSource="{Binding Snapshot.AvailableActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.ChooseActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ActionButton}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <TextBlock Text="Выберите врага для цели..." Style="{StaticResource MutedText}" Margin="0,8,0,0"
                       Visibility="{Binding IsAwaitingTarget, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="События" Style="{StaticResource SectionTitle}" DockPanel.Dock="Top" />
                <ListBox ItemsSource="{Binding EventFeed}" Background="Transparent" BorderThickness="0"
                         Margin="0,8,0,0" />
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Лог" Style="{StaticResource SectionTitle}" DockPanel.Dock="Top" />
                <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                         Margin="0,8,0,0" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
