<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sektor.TurnBased.UI.Wpf.Controls">
    <Grid Background="{StaticResource BgBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ: раунд, статус, очередь ходов (общая для всех раскладок) -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="2"
                CornerRadius="4">
            <Border.Background>
                <StaticResource ResourceKey="PanelGradientBrush" />
            </Border.Background>
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <controls:RoundControl Value="{Binding Snapshot.RoundNumber}" />
                    <TextBlock Text="Раунд"
                               Style="{StaticResource MutedText}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Status}"
                           Style="{StaticResource StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <DockPanel Grid.Column="2"
                           VerticalAlignment="Center">
                    <Button Content="В лобби"
                            Command="{Binding GoToLobbyCommand}"
                            Style="{StaticResource NeutralButton}"
                            DockPanel.Dock="Right"
                            Margin="12,0,0,0" />
                    <controls:TurnOrderControl ItemsSource="{Binding TurnQueue}" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- ПОЛЕ БОЯ -->
        <Grid Grid.Row="1">

            <!-- Раскладка 1: две линии с информативными карточками -->
            <StackPanel Visibility="{Binding IsSingleLineLayout, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Ваши герои" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding PlayerUnits}"
                                  ItemTemplate="{StaticResource UnitCardTemplate}"
                                  Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Враги" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding EnemyUnits}"
                                  ItemTemplate="{StaticResource UnitCardTemplate}"
                                  Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Раскладка 2: одна линия, все юниты в ряд (стиль Blades) -->
            <Grid Visibility="{Binding IsSingleLineLayout, Converter={StaticResource BoolToVisibility}}">
                <Grid.Background>
                    <StaticResource ResourceKey="BattlefieldBrush" />
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="VS"
                           Foreground="{StaticResource VsBrush}"
                           FontSize="60"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Red"
                                          BlurRadius="30"
                                          ShadowDepth="0"
                                          Opacity="0.8" />
                    </TextBlock.Effect>
                </TextBlock>

                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding PlayerUnits}"
                              ItemTemplate="{StaticResource UnitCardLineTemplate}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        FlowDirection="RightToLeft" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding EnemyUnits}"
                              ItemTemplate="{StaticResource UnitCardLineTemplate}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- Кровавая виньетка (включается в настройках) -->
            <Rectangle Fill="{StaticResource BloodVignetteBrush}"
                       IsHitTestVisible="False"
                       Visibility="{Binding Settings.RedVignette, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- НИЖНЯЯ ПАНЕЛЬ: действия -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="2"
                CornerRadius="4">
            <Border.Background>
                <StaticResource ResourceKey="PanelGradientBrush" />
            </Border.Background>
            <Grid Margin="12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button Content="Завершить ход"
                            Command="{Binding EndTurnCommand}"
                            Style="{StaticResource PrimaryButton}"
                            DockPanel.Dock="Right" />
                    <ItemsControl ItemsSource="{Binding Snapshot.AvailableActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Command="{Binding DataContext.ChooseActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ActionButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,8,0,0">
                    <TextBlock Text="Выберите врага для цели..."
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding IsAwaitingTarget, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Hint}"
                               Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource ErrorText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
