<UserControl x:Class="Sektor.TurnBased.UI.Wpf.Views.MultiplayerLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- Заголовок -->
                <DockPanel Margin="0,0,0,16">
                    <Button Content="← В лобби" Command="{Binding GoToLobbyCommand}"
                            Style="{StaticResource NeutralButton}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBlock Text="Мультиплеер" Style="{StaticResource PageTitle}" />
                </DockPanel>

                <!-- Инициализация Steam -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel Margin="0,8">
                        <TextBlock Text="Steam" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="Инициализировать Steam" Command="{Binding InitializeCommand}"
                                Style="{StaticResource NeutralButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Создание/Вход (когда не в сессии) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding IsSessionActive, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Margin="0,8">
                        <TextBlock Text="Подключение" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                        <Button Content="Создать лобби" Command="{Binding CreateLobbyCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <Separator Background="{StaticResource PanelBorderBrush}" Height="1" Margin="0,4" />

                        <TextBlock Text="Lobby ID:" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding JoinSessionId, UpdateSourceTrigger=PropertyChanged}"
                                 MaxWidth="400" HorizontalAlignment="Left"
                                 Background="{StaticResource PanelDarkBrush}" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource PanelBorderBrush}" Padding="8,6"
                                 FontSize="14" Margin="0,0,0,8" />
                        <Button Content="Присоединиться" Command="{Binding JoinLobbyCommand}"
                                Style="{StaticResource NeutralButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Активная сессия -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,8">

                        <!-- Lobby ID -->
                        <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                            <DockPanel>
                                <Button Content="Копировать" Command="{Binding CopyLobbyIdCommand}"
                                        Style="{StaticResource NeutralButton}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                        FontSize="12" Padding="8,4" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                    <TextBlock Text="Lobby ID:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding LobbyId}" Style="{StaticResource BodyText}"
                                               FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Список игроков -->
                        <TextBlock Text="Игроки:" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Players}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,4" Padding="12,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       FontSize="18" FontWeight="Bold" Margin="12,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="○" />
                                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                <Setter Property="Text" Value="✓" />
                                                                <Setter Property="Foreground" Value="#4CAF50" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       FontSize="12" Margin="12,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHost}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Text" Value="(хост)" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color}" />
                                                </Border.Background>
                                            </Border>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" />
                                                <TextBlock Text="{Binding ClassName}" Style="{StaticResource MutedText}"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Выбор класса (для не-хоста) -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                                Visibility="{Binding IsHost, Converter={StaticResource InverseBoolToVisibility}}">
                            <DockPanel>
                                <Button Content="←" Command="{Binding SelectClassLeftCommand}"
                                        Style="{StaticResource NeutralButton}" DockPanel.Dock="Left"
                                        Width="48" FontSize="20" />
                                <Button Content="→" Command="{Binding SelectClassRightCommand}"
                                        Style="{StaticResource NeutralButton}" DockPanel.Dock="Right"
                                        Width="48" FontSize="20" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                                    <TextBlock Text="{Binding CurrentClassName}"
                                               Style="{StaticResource PageTitle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentClassDescription}"
                                               Style="{StaticResource MutedText}" TextAlignment="Center"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Готовность (для не-хоста) -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                                Visibility="{Binding IsHost, Converter={StaticResource InverseBoolToVisibility}}">
                            <CheckBox Command="{Binding ToggleReadyCommand}"
                                      IsChecked="{Binding IsReady, Mode=OneWay}"
                                      FontSize="16" Foreground="{StaticResource TextBrush}">
                                <CheckBox.Content>
                                    <TextBlock Text="Готов к бою" Style="{StaticResource BodyText}" />
                                </CheckBox.Content>
                            </CheckBox>
                        </Border>

                        <!-- Старт (для хоста) -->
                        <Button Content="Начать бой" Command="{Binding StartGameCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                                FontSize="18" Padding="32,12" Margin="0,12,0,0"
                                Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibility}}" />

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
